# ---- Google Earth Engine ----
GEE_PROJECT=semiotic-timer-429307-g6
# Local dev: leave the three below empty and run `earthengine authenticate` once.
# Production: service account registered for Earth Engine.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
# Or the whole JSON key on one line (best for Render / Cloud Run):
GEE_PRIVATE_KEY_JSON=

# ---- Boundary asset (the service account must be able to READ it) ----
BOUNDARY_ASSET=projects/semiotic-timer-429307-g6/assets/District_Boundary
# Leave blank to auto-detect the column names, or set them exactly:
PROVINCE_FIELD=
DISTRICT_FIELD=
DEFAULT_PROVINCE=Punjab

# ---- CORS: comma-separated frontend origins ----
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080

# ---- Dashboard login (optional) ----
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
DASH_USER=admin
# python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
# Keep the single quotes - the hash contains $ characters.
DASH_PASS_HASH=''
